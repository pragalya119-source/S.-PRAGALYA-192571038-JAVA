5(d) Lambda Expression – Console version
import java.util.Scanner;

class Main {
    interface Convert {
        void calculate(double amount, String currency);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Convert c = (amount, currency) -> {
            if (amount <= 0) {
                System.out.println("Invalid amount");
            } else if (currency.equalsIgnoreCase("USD")) {
                System.out.println("Result: " + (amount * 0.012));
            } else if (currency.equalsIgnoreCase("EUR")) {
                System.out.println("Result: " + (amount * 0.011));
            } else {
                System.out.println("Invalid Currency");
            }
        };

        System.out.print("Enter INR Amount: ");
        double amount = sc.nextDouble();

        System.out.print("Enter Currency: ");
        String currency = sc.next();

        c.calculate(amount, currency);
    }
}
