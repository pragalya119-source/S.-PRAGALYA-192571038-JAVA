import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[] departments = {"Cardiology", "Neurology", "Orthopaedics"};

        System.out.println("Departments:");
        for (int i = 0; i < departments.length; i++) {
            System.out.println((i + 1) + ". " + departments[i]);
        }

        System.out.print("Enter Patient ID: ");
        String id = sc.nextLine();

        System.out.print("Select Department (1-3): ");
        int choice = sc.nextInt();

        if (choice < 1 || choice > 3 || id.trim().isEmpty()) {
            System.out.println("Invalid Details");
            return;
        }

        String department = departments[choice - 1];
        String[] doctors;

        if (choice == 1) {
            doctors = new String[]{"Dr. Kumar", "Dr. Ravi"};
        } else if (choice == 2) {
            doctors = new String[]{"Dr. Priya", "Dr. Arun"};
        } else {
            doctors = new String[]{"Dr. John", "Dr. Meena"};
        }

        System.out.println("Available Doctors:");
        for (int i = 0; i < doctors.length; i++) {
            System.out.println((i + 1) + ". " + doctors[i]);
        }

        System.out.print("Select Doctor: ");
        int doctor = sc.nextInt();

        if (doctor < 1 || doctor > doctors.length) {
            System.out.println("Invalid Doctor");
            return;
        }

        sc.nextLine();
        System.out.print("Enter Time Slot: ");
        String time = sc.nextLine();

        if (time.trim().isEmpty()) {
            System.out.println("Invalid Time Slot");
        } else {
            System.out.println("Appointment Booked Successfully");
            System.out.println("Patient ID: " + id);
            System.out.println("Department: " + department);
            System.out.println("Doctor: " + doctors[doctor - 1]);
            System.out.println("Time: " + time);
        }
    }
}
